# Python
.venv/
# portable Python embeddable (built by tools/build_portable.ps1)
python/
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.pytest_cache/
.mypy_cache/

# Service runtime artifacts
server.log
server.err.log
# Update-OCR.bat backups (contain server/config.json)
backup-*/
# contains real api_token - never commit
server/config.json

# Build artifacts (per-machine)
# NOTE: userscript/local-captcha-autofill.user.js is intentionally tracked.
# It contains NO secrets (server URL + token are entered in the browser and
# stored in GM storage), so it is safe to publish for auto-updating.
# portable package built by tools/build_portable.ps1
OCR-portable.zip
# The panel shortcut embeds an absolute path, so it is machine-specific.
# It is never committed and never shipped: tools\make_shortcut.ps1 rebuilds it
# on the target machine (setup_new_server.ps1, update_ocr.ps1, panel.ps1).
*.lnk

# Test artifacts
docs/TEST-REPORT-*.md
tools/test-assets/benchmark-report.html
tools/test-assets/result*.png
tools/test-assets/edge-profile/

# Agent scratch files (see AGENTS.md section 1: delete these, do not hoard them)
__*
tmp/
scratch/

# IDE
.vscode/
.idea/
*.swp
.DS_Store

# Runtime debug images (written by save_debug_images when on)
debug-images/
